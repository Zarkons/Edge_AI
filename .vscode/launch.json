{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Whisper Direct Pipe Debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "targetArchitecture": "arm64",
            "program": "${workspaceFolder}/bazel-bin/risc-v/tensix_vector_kernel",
            "miDebuggerPath": "/opt/homebrew/bin/riscv64-elf-gdb",
            "MIMode": "gdb",
            "stopAtEntry": true,
            "setupCommands": [
                {
                    "text": "set architecture riscv:rv32"
                },
                {
                    "text": "target remote | ${workspaceFolder}/third_party/whisper/whisper --isa rv32imaf --gdb ${workspaceFolder}/bazel-bin/risc-v/tensix_vector_kernel"
                }
            ],
            "launchCompleteCommand": "None"
        },
        {
            "name": "Debug Existing App Binary (Direct Native)",
            "type": "lldb", // Uses the CodeLLDB extension backend
            "request": "launch",
            "cwd": "/",
            "program": "${workspaceFolder}/bazel-bin/demo_applications/object_recognition/application/custom_inference_engine_app",
            "args": [],
            "sourceMap": { // Key swap: CodeLLDB uses 'sourceMap'
                "bazel-out/darwin_arm64-opt/bin/demo_applications/object_recognition/application/_virtual_includes/frame_handler": "${workspaceFolder}/demo_applications/object_recognition/application/api",
                "demo_applications": "${workspaceFolder}/demo_applications",
                "bazel-out": "${workspaceFolder}/bazel-out",
                ".": "${workspaceFolder}"
            }
        }
    ]
}